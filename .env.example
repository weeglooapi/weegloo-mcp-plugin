# Repo-root .env template. Copy to `.env` (gitignored) and fill in the real values.
# Nothing here is a secret by itself — but this repository is public, so the production
# announcement target is kept out of it. See scripts/post-announcement.mjs.

# Where `npm run`-less `node scripts/post-announcement.mjs` posts the release announcement.
# Both ids come from the Weegloo console (Space → its announcement ContentType).
WEEGLOO_SPACE_ID=xxxxxxxx
WEEGLOO_CONTENT_TYPE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults to production CMA when unset.
# WEEGLOO_CMA_BASE=https://cma.weegloo.com/v1

# The CMA Bearer token is deliberately NOT read from this file: it is a secret and is passed
# as a runtime environment variable for the one command that needs it.
#   WEEGLOO_CMA_TOKEN='<token>' node scripts/post-announcement.mjs
